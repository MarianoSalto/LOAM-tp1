<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@id/fragment_a">

    <fragment
        android:id="@+id/fragment_a"
        android:name="com.example.primertpdeappmoviles.presentation.fragment.FragmentA"
        android:label="fragment_a"
        tools:layout="@layout/fragment_a" >
        <action
            android:id="@+id/action_fragment_a_to_fragment_b"
            app:destination="@id/fragment_b" />
        <action
            android:id="@+id/action_fragment_a_to_fragment_c"
            app:destination="@id/fragment_c" />
        <action
            android:id="@+id/action_fragment_a_to_fragmentD"
            app:destination="@id/fragmentD" />
    </fragment>

    <fragment
        android:id="@+id/fragment_b"
        android:name="com.example.primertpdeappmoviles.presentation.fragment.FragmentB"
        android:label="fragment_b"
        tools:layout="@layout/fragment_b" >
        <argument
            android:name="sample"
            app:argType="string"
            android:defaultValue="default" />
        <action
            android:id="@+id/action_fragment_b_to_fragment_a"
            app:destination="@id/fragment_a" />
        <action
            android:id="@+id/action_fragment_b_to_fragment_c"
            app:destination="@id/fragment_c" />
        <action
            android:id="@+id/action_fragment_b_to_fragmentD"
            app:destination="@id/fragmentD" />
    </fragment>

    <fragment
        android:id="@+id/fragment_c"
        android:name="com.example.primertpdeappmoviles.presentation.fragment.FragmentC"
        android:label="fragment_c"
        tools:layout="@layout/fragment_c" >
        <action
            android:id="@+id/action_fragment_c_to_fragment_a"
            app:destination="@id/fragment_a" />
        <action
            android:id="@+id/action_fragment_c_to_fragment_b"
            app:destination="@id/fragment_b" />
        <action
            android:id="@+id/action_fragment_c_to_fragmentD"
            app:destination="@id/fragmentD" />
    </fragment>
    <fragment
        android:id="@+id/fragmentD"
        android:name="com.example.primertpdeappmoviles.presentation.fragment.FragmentD"
        android:label="fragmento_d"
        tools:layout="@layout/fragment_d" >
        <action
            android:id="@+id/action_fragmentD_to_fragment_b"
            app:destination="@id/fragment_b" />
        <action
            android:id="@+id/action_fragmentD_to_fragment_a"
            app:destination="@id/fragment_a" />
        <action
            android:id="@+id/action_fragmentD_to_fragment_c"
            app:destination="@id/fragment_c" />
    </fragment>


</navigation>